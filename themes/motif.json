  "tokenColors": [
    {
      "name": "Text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#D8D0C8"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#AAB2B5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "variable.language",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#D4A87D"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#B5B1AD"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#B5B1AD"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#CEAE4C"
      }
    },
    {
      "name": "Escape and regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder",
        "constant.character.format"
      ],
      "settings": {
        "foreground": "#CCDD77"
      }
    },
    {
      "name": "Number and constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#E49E9C"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#D8D0C8"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#D8D0C8"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call.generic",
        "support.function.magic",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#A9B789"
      }
    },
    {
      "name": "Builtin function",
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#CCDD77"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.interface",
        "entity.name.enum",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#C0A9C4"
      }
    },
    {
      "name": "Builtin type",
      "scope": [
        "keyword.type",
        "storage.type.primitive",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#C0A9C4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorator and attribute",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "meta.attribute",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#CCDD77"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#D4A87D"
      }
    },
    {
      "name": "Tag attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A9B789",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Object key",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#A9B789"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#D4A87D"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E3A298"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#CEAE4C",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Heading",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading.setext"
      ],
      "settings": {
        "foreground": "#D4A87D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#D4A87D"
      }
    },
    {
      "name": "Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#CEAE4C"
      }
    },
    {
      "name": "Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#AAB2B5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "List marker",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list"
      ],
      "settings": {
        "foreground": "#CCDD77"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#81C08E"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#E3A298"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#CEAE4C"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#C0A9C4",
    "type": "#C0A9C4",
    "class": "#C0A9C4",
    "struct": "#C0A9C4",
    "interface": "#C0A9C4",
    "enum": "#C0A9C4",
    "typeParameter": {
      "foreground": "#C0A9C4",
      "italic": true
    },
    "enumMember": "#E49E9C",
    "function": "#A9B789",
    "method": "#A9B789",
    "function.defaultLibrary": "#CCDD77",
    "macro": "#CCDD77",
    "decorator": "#CCDD77",
    "keyword": "#D4A87D",
    "variable": "#D8D0C8",
    "variable.readonly": "#E49E9C",
    "variable.defaultLibrary": "#CCDD77",
    "parameter": "#D8D0C8",
    "property": "#D8D0C8",
    "property.readonly": "#D8D0C8",
    "string": "#CEAE4C",
    "number": "#E49E9C",
    "regexp": "#CCDD77",
    "operator": "#B5B1AD",
    "comment": {
      "foreground": "#AAB2B5",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
